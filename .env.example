# ==============================================================================
# PromptShield — Environment Configuration
# ==============================================================================

ENVIRONMENT=development
PORT=8080
HOST=0.0.0.0

# Master Admin Key for Dashboard & Metrics
SHIELD_API_KEY=ps_live_master_key_secret_2026

# Upstream LLM Configuration (When running as OpenAI-compatible Proxy)
UPSTREAM_LLM_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-openai-api-key-here

# Security Thresholds & Policies
INJECTION_RISK_THRESHOLD=0.65       # 0.0 (Strict) to 1.0 (Permissive)
BLOCK_ON_INJECTION=true             # Reject or sanitize when injection is detected
REDACT_PII=true                     # Automatically mask emails, credit cards, phones, keys
MAX_TOKEN_BUDGET_PER_REQUEST=4096   # DoS token flood mitigation
ENABLE_AUDIT_LOGS=true
